{
  "name": "resource-consumer-server",
  "version": "1.0.0",
  "description": "A Node.js server that consumes system resources at a steady rate of 3KB per second",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "keywords": [
    "nodejs",
    "resource-consumer",
    "server"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": "server.js",
    "targets": ["node18-win-x64"],
    "outputPath": "dist"
  }
}